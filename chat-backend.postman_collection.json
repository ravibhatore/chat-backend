{
  "info": {
    "_postman_id": "a9c18512-8756-4d92-9112-9856cbf20111",
    "name": "Chat Backend API",
    "description": "Postman collection for Chat Backend with PostgreSQL (Prisma) and Firebase Firestore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "userAId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userBId",
      "value": "",
      "type": "string"
    },
    {
      "key": "chatId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Create User A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.id) { pm.collectionVariables.set('userAId', jsonData.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice_test@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/user/create",
          "host": ["{{baseUrl}}"],
          "path": ["user", "create"]
        }
      }
    },
    {
      "name": "2. Create User B",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.id) { pm.collectionVariables.set('userBId', jsonData.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob\",\n  \"email\": \"bob_test@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/user/create",
          "host": ["{{baseUrl}}"],
          "path": ["user", "create"]
        }
      }
    },
    {
      "name": "3. Create or Get Chat (API 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.chatId) { pm.collectionVariables.set('chatId', jsonData.chatId); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"{{userBId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/create",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "create"]
        }
      }
    },
    {
      "name": "4. Send Message (API 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.messageId) { pm.collectionVariables.set('messageId', jsonData.messageId); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hello Bob! This is sent to Firestore.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "send"]
        }
      }
    },
    {
      "name": "5. Get Messages (API 3)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50&userId={{userAId}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "messages"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "userId", "value": "{{userAId}}" }
          ]
        }
      }
    },
    {
      "name": "6. Mark Message Read (API 4)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "{{messageId}}", "read"]
        }
      }
    },
    {
      "name": "7. Update Last Seen (API 5)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\",\n  \"messageId\": \"{{messageId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/lastseen",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "lastseen"]
        }
      }
    },
    {
      "name": "8. List User Chats (API 6)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/{{userAId}}/chats",
          "host": ["{{baseUrl}}"],
          "path": ["user", "{{userAId}}", "chats"]
        }
      }
    },
    {
      "name": "9. Bonus: Create Group Chat",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"creatorId\": \"{{userAId}}\",\n  \"name\": \"Sprint Planning Team\",\n  \"memberIds\": [\"{{userBId}}\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/group/create",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "group", "create"]
        }
      }
    },
    {
      "name": "10. Bonus: Edit Message",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userAId}}\",\n  \"text\": \"Edited message content\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "{{messageId}}"]
        }
      }
    },
    {
      "name": "11. Bonus: Delete Message",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userAId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "message", "{{messageId}}"]
        }
      }
    }
  ]
}

